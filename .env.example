# LLM API 配置（所有环境共用）
API_BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-4o-mini

# 运行环境 (dev / test / prod)
# 通过环境变量设置: APP_ENV=dev|test|prod
# 也可以通过 .env.{env} 文件配置不同环境的密钥
# 例如: .env.dev, .env.test, .env.prod
APP_ENV=dev

# 数据库配置（MySQL 后端使用，生产环境建议配置在 .env.prod 中）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=langchain_chat
